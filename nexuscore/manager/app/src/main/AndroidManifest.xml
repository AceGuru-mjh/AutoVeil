<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service for future use -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Custom permission to protect SuRequestActivity.
        Only processes holding this permission (i.e., daemon via setPermissions)
        can start SuRequestActivity.
    -->
    <permission
        android:name="nexus.permission.SU_REQUEST"
        android:protectionLevel="signature|privileged"
        android:label="NexusCore SU Request"
        android:description="@string/su_request_perm_desc" />

    <application
        android:name=".NexusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusManager"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NexusManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SuRequestActivity: standalone Activity for SU authorization.
            exported=true: allows daemon (root) to start via 'am start'
            permission=nexus.permission.SU_REQUEST: only permitted processes can start
            launchMode=singleTask: avoid duplicate instances
            excludeFromRecents=true: not shown in recent tasks
            noHistory=true: auto finish when user navigates away
            taskAffinity="": independent task
        -->
        <activity
            android:name=".SuRequestActivity"
            android:exported="true"
            android:permission="nexus.permission.SU_REQUEST"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.NexusManager"
            android:label="@string/su_request_title" />

        <!-- Legacy alias for backward compatibility -->
        <activity-alias
            android:name=".SuRequestActivityAlias"
            android:exported="false"
            android:targetActivity=".SuRequestActivity" />
    </application>
</manifest>
